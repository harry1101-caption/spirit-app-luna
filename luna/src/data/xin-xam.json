[
 {
  "so": 1,
  "cap": "Thượng thượng",
  "tho": [
   "開天辟地作良緣",
   "吉日良時萬物全",
   "若得此籤非小可",
   "人行忠正帝王宣"
  ],
  "dienTich": "盤古開天辟地"
 },
 {
  "so": 2,
  "cap": "Trung hạ",
  "tho": [
   "鲸魚未變守江河",
   "不可升騰更望高",
   "異日峥嵘身變化",
   "許君一躍跳龍門"
  ],
  "dienTich": "蘇秦不第"
 },
 {
  "so": 3,
  "cap": "Hạ",
  "tho": [
   "臨風冒雨去還鄉",
   "正是其身似燕兒",
   "銜得坭來欲作壘",
   "到頭壘壞複須泥"
  ],
  "dienTich": "董永遇仙"
 },
 {
  "so": 4,
  "cap": "Trung bình",
  "tho": [
   "菱花鏡破複重圓",
   "女再求夫男再婚",
   "自此門闾重改換",
   "更添福棱與兒孫"
  ],
  "dienTich": "玉蓮會十朋"
 },
 {
  "so": 5,
  "cap": "Trung bình",
  "tho": [
   "一錐草地要求泉",
   "努力求之得最難",
   "無意俄然遇知己",
   "相逢攜手上青天"
  ],
  "dienTich": "劉晨遇仙／燕昭王築黃金台"
 },
 {
  "so": 6,
  "cap": "Trung bình",
  "tho": [
   "投身岩下飼于菟",
   "須是還他大丈夫",
   "舍己也應難再得",
   "通行天下此人無"
  ],
  "dienTich": "仁貴遇主"
 },
 {
  "so": 7,
  "cap": "Hạ",
  "tho": [
   "奔波阻隔重重險",
   "帶水拖泥去度山",
   "更望他鄉求用事",
   "千鄉萬裡未回還"
  ],
  "dienTich": "蘇娘走難"
 },
 {
  "so": 8,
  "cap": "Thượng thượng",
  "tho": [
   "茂林松柏正興旺",
   "雨雪風霜總不摧",
   "異日自然成大用",
   "功名作個棟梁材"
  ],
  "dienTich": "姚能遇仙／裴度還帶"
 },
 {
  "so": 9,
  "cap": "Thượng thượng",
  "tho": [
   "煩君勿作私心事",
   "此意偏宜說問公",
   "一片明心光皎潔",
   "宛如皎月正天中"
  ],
  "dienTich": "孔明點將／趙普半部論語定天下"
 },
 {
  "so": 10,
  "cap": "Trung bình",
  "tho": [
   "石藏無價玉和珍",
   "隻管他鄉外客尋",
   "宛如持燈更覓火",
   "不如收拾枉勞心"
  ],
  "dienTich": "龐涓觀陣"
 },
 {
  "so": 11,
  "cap": "Thượng thượng",
  "tho": [
   "欲求勝事可非常",
   "争奈親姻日暫忙",
   "到頭竟必成鹿箭",
   "貴人指引貴人鄉"
  ],
  "dienTich": "書薦姜維"
 },
 {
  "so": 12,
  "cap": "Thượng thượng",
  "tho": [
   "否去泰來咫尺間",
   "暫交君子出于山",
   "若逢虎兔佳音信",
   "立志忙中事即閑"
  ],
  "dienTich": "武吉遇師"
 },
 {
  "so": 13,
  "cap": "Thượng thượng",
  "tho": [
   "自小生身富貴家",
   "眼前萬事總奢華",
   "蒙君賜受金魚袋",
   "四海傳名足可誇"
  ],
  "dienTich": "羅通拜帥／信陵君辭封"
 },
 {
  "so": 14,
  "cap": "Trung cát",
  "tho": [
   "宛如仙鶴出凡籠",
   "脫得凡籠路路通",
   "南北東西無阻隔",
   "任君直上九霄宮"
  ],
  "dienTich": "《封神榜》子牙棄官"
 },
 {
  "so": 15,
  "cap": "Trung bình",
  "tho": [
   "行人一日氣難吞",
   "忽有災事勿近前",
   "巢破林鳥無所宿",
   "可尋深處穩安身"
  ],
  "dienTich": "蘇秦得志"
 },
 {
  "so": 16,
  "cap": "Trung cát",
  "tho": [
   "攢眉思慮暫時開",
   "咫尺雲開見日來",
   "宛如污泥中片玉",
   "良工一舉出塵埃"
  ],
  "dienTich": "葉夢熊朝帝"
 },
 {
  "so": 17,
  "cap": "Trung bình",
  "tho": [
   "莫聽閑言說是非",
   "晨昏隻好念阿彌",
   "若将狂話為真實",
   "書餅如何止得饑"
  ],
  "dienTich": "畫餅充饑"
 },
 {
  "so": 18,
  "cap": "Thượng thượng",
  "tho": [
   "金烏西墜兔東臨",
   "日夜循環恒古今",
   "僧道得之無不利",
   "工商農士各開心"
  ],
  "dienTich": "曹國舅為仙"
 },
 {
  "so": 19,
  "cap": "Trung cát",
  "tho": [
   "急水灘頭放船歸",
   "風波作浪欲何為",
   "若要安然求穩靜",
   "等待浪靜過此危"
  ],
  "dienTich": "子儀封王"
 },
 {
  "so": 20,
  "cap": "Trung cát",
  "tho": [
   "當春久雨喜初晴",
   "玉兔金烏漸漸明",
   "舊事已成新事遂",
   "看看一跳入蓬瀛"
  ],
  "dienTich": "姜太公遇文王、蘇武歸漢"
 },
 {
  "so": 21,
  "cap": "Thượng cát",
  "tho": [
   "陰陽道合總由天",
   "女嫁男婚喜偎然",
   "但見龍蛇相會合",
   "熊罴入夢樂團圓"
  ],
  "dienTich": "李旦龍鳳配合"
 },
 {
  "so": 22,
  "cap": "Thượng cát",
  "tho": [
   "四郊田畝皆枯竭",
   "久旱俄然三日霖",
   "花果草芽俱潤澤",
   "始知一雨值千金"
  ],
  "dienTich": ""
 },
 {
  "so": 23,
  "cap": "Trung bình",
  "tho": [
   "欲扳仙桂入蟾宮",
   "豈慮天門不開放",
   "忽遇一般音信好",
   "人人皆笑嶺頂花"
  ],
  "dienTich": "懷德招親"
 },
 {
  "so": 24,
  "cap": "Hạ",
  "tho": [
   "不成鄰裡不成家",
   "水泡癡人似落花",
   "若問君恩難得力",
   "到頭畢竟事如麻"
  ],
  "dienTich": "癡人喪德"
 },
 {
  "so": 25,
  "cap": "Trung cát",
  "tho": [
   "過了憂危事幾重",
   "從今再曆永無兇",
   "寬心自有寬心計",
   "得遇高人護聖功"
  ],
  "dienTich": "古井逢泉"
 },
 {
  "so": 26,
  "cap": "Trung bình",
  "tho": [
   "上下傳來事轉虛",
   "天邊接得一封書",
   "書中許我功名遂",
   "直到終時亦是虛"
  ],
  "dienTich": "鐘馗得道"
 },
 {
  "so": 27,
  "cap": "Trung bình",
  "tho": [
   "一謀一用一番書",
   "慮後思前不敢為",
   "時到貴人相助力",
   "如山壁立可安居"
  ],
  "dienTich": "劉基諫主"
 },
 {
  "so": 28,
  "cap": "Trung cát",
  "tho": [
   "東邊月上正婵娟",
   "頃刻雲遮亦暗存",
   "或有圓時還有缺",
   "更言非者亦閑言"
  ],
  "dienTich": "包公尋李後"
 },
 {
  "so": 29,
  "cap": "Thượng cát",
  "tho": [
   "寶劍光芒出匣時",
   "匣中應不被塵欺",
   "貴人親手提攜起",
   "盡可防身更勿疑"
  ],
  "dienTich": "趙子龍救阿鬥／百裡奚飼牛入相"
 },
 {
  "so": 30,
  "cap": "Hạ",
  "tho": [
   "勸君切莫向他求",
   "似鶴飛來暗箭投",
   "若去采薪蛇伏草",
   "恐遭毒手也堪憂"
  ],
  "dienTich": "棋盤大會"
 },
 {
  "so": 31,
  "cap": "Trung bình",
  "tho": [
   "清閑無憂靜處坐",
   "飽後喝茶時坐卧",
   "放下身心不用忙",
   "必定不招冤與禍"
  ],
  "dienTich": "佛印會東坡"
 },
 {
  "so": 32,
  "cap": "Trung hạ",
  "tho": [
   "渺渺前途事可疑",
   "石中藏玉有誰知",
   "一朝良匠分明剖",
   "始覺其中碧玉奇"
  ],
  "dienTich": "劉備三顧茅廬"
 },
 {
  "so": 33,
  "cap": "Trung bình",
  "tho": [
   "内藏無價寶和珍",
   "得玉何須外界尋",
   "不如等待高人識",
   "寬心猶且更寬心"
  ],
  "dienTich": "咬金聘仁貴"
 },
 {
  "so": 34,
  "cap": "Thượng thượng",
  "tho": [
   "出入行藏禮義恭",
   "言必忠良聽必聰",
   "心下了然俱洞澈",
   "光明如日正當空"
  ],
  "dienTich": "桃園結義"
 },
 {
  "so": 35,
  "cap": "Trung bình",
  "tho": [
   "衣冠重整舊家風",
   "道是無功卻有功",
   "掃卻當途荊棘礙",
   "三人共議事和同"
  ],
  "dienTich": "劉關張古城相會"
 },
 {
  "so": 36,
  "cap": "Trung bình",
  "tho": [
   "眼前病訟不須憂",
   "寶地資財盡可求",
   "恰似猿猴金鎖脫",
   "自歸山洞去來悠"
  ],
  "dienTich": "湘子遇賓"
 },
 {
  "so": 37,
  "cap": "Trung bình",
  "tho": [
   "欲待身安運泰時",
   "風中燈燭不相宜",
   "不如收拾深堂坐",
   "庶免光搖靜處明"
  ],
  "dienTich": "李靖歸山"
 },
 {
  "so": 38,
  "cap": "Hạ",
  "tho": [
   "鏡月當空出匣時",
   "刹那雲霧暗昏迷",
   "寬心守時浮雲散",
   "更改相宜可望為"
  ],
  "dienTich": "何文秀遇難"
 },
 {
  "so": 39,
  "cap": "Hạ",
  "tho": [
   "天邊消息應難問",
   "切莫私心強望求",
   "若把石頭磨作鏡",
   "精神枉費一時休"
  ],
  "dienTich": "姜女尋夫／祢衡投黃祖"
 },
 {
  "so": 40,
  "cap": "Trung bình",
  "tho": [
   "紅輪西墜兔東升",
   "陰長陽消百事亨",
   "若是女人宜望用",
   "增添財祿福其心"
  ],
  "dienTich": "武則天登位"
 },
 {
  "so": 41,
  "cap": "Trung bình",
  "tho": [
   "無限好言君記取",
   "卻為認賊將作子",
   "莫貪眼下有些甜",
   "更慮他年前樣看"
  ],
  "dienTich": "董卓收呂布"
 },
 {
  "so": 42,
  "cap": "Thượng thượng",
  "tho": [
   "君垂恩澤潤無邊",
   "覆禱祈穰沒黨偏",
   "一切有情皆受用",
   "均沾樂利得周全"
  ],
  "dienTich": "目蓮救母"
 },
 {
  "so": 43,
  "cap": "Thượng thượng",
  "tho": [
   "天地交泰萬物新",
   "自形自色自怡神",
   "森羅萬象皆精彩",
   "事事合諧得稱人"
  ],
  "dienTich": "行者得道／劉邦起於布衣而成帝業"
 },
 {
  "so": 44,
  "cap": "Trung bình",
  "tho": [
   "棋逢敵手要藏機",
   "黑白盤中未決時",
   "到底欲知誰勝負",
   "須教先著相機宜"
  ],
  "dienTich": "姜維與鄧艾鬥陣／周瑜赤壁之戰"
 },
 {
  "so": 45,
  "cap": "Thượng thượng",
  "tho": [
   "溫柔自是勝強剛",
   "行善于門大吉昌",
   "若是有人占此卦",
   "宛如正渴遇瓊漿"
  ],
  "dienTich": "仁宗認母"
 },
 {
  "so": 46,
  "cap": "Trung bình",
  "tho": [
   "勸君耐守舊生涯",
   "把定身心莫聽邪",
   "直待有人輕著力",
   "滿園枯木再開花"
  ],
  "dienTich": "渭水釣魚"
 },
 {
  "so": 47,
  "cap": "Thượng thượng",
  "tho": [
   "錦上添花色愈鮮",
   "運來祿馬喜雙全",
   "時人莫恨功名晚",
   "一舉登科四海傳"
  ],
  "dienTich": "梁灝登科"
 },
 {
  "so": 48,
  "cap": "Trung bình",
  "tho": [
   "靈鳥秋來化作鵬",
   "翺翔得意盡飛騰",
   "直沖萬裡雲霄外",
   "任是諸禽總不能"
  ],
  "dienTich": "韓信挂帥"
 },
 {
  "so": 49,
  "cap": "Trung bình",
  "tho": [
   "天寒地凍水成冰",
   "何須貪吝取功名",
   "隻好守己靜處坐",
   "待時興變自然明"
  ],
  "dienTich": "王祥求鯉"
 },
 {
  "so": 50,
  "cap": "Thượng cát",
  "tho": [
   "五湖四海盡行船",
   "高挂風帆把舵堅",
   "幸得順風隨所至",
   "滿船寶貝稱心田"
  ],
  "dienTich": "陶朱歸五湖"
 },
 {
  "so": 51,
  "cap": "Trung bình",
  "tho": [
   "夏日初臨日正長",
   "人皆愁惱熱非常",
   "天公也解諸人意",
   "故遣薰風特送涼"
  ],
  "dienTich": "孔明入川"
 },
 {
  "so": 52,
  "cap": "Hạ",
  "tho": [
   "水中捉月費功夫",
   "費盡功夫卻又無",
   "莫信閑言并浪論",
   "枉抛心力也難圖"
  ],
  "dienTich": "太白醉撈明月"
 },
 {
  "so": 53,
  "cap": "Trung cát",
  "tho": [
   "失意翻成得意時",
   "龍吟虎嘯兩相宜",
   "青雲有路終須到",
   "許我功名必可期"
  ],
  "dienTich": "劉備招親"
 },
 {
  "so": 54,
  "cap": "Hạ",
  "tho": [
   "夢中得寶醒來無",
   "自謂南山隻是鋤",
   "若問婚姻并問病",
   "别尋修路為相扶"
  ],
  "dienTich": "馬超追曹"
 },
 {
  "so": 55,
  "cap": "Trung cát",
  "tho": [
   "父賢傳子子傳孫",
   "衣食豐隆隻靠天",
   "堂上椿萱人快樂",
   "饑飯渴飲困時眠"
  ],
  "dienTich": "周武王登位"
 },
 {
  "so": 56,
  "cap": "Trung bình",
  "tho": [
   "澗小石粗流水響",
   "力勞撐駕恐參傷",
   "路須指出前江去",
   "風靜潮平盡不妨"
  ],
  "dienTich": "安祿山謀反"
 },
 {
  "so": 57,
  "cap": "Trung cát",
  "tho": [
   "聞是聞非風過耳",
   "好衣好祿日當空",
   "君須記取他年事",
   "汝意還同我意同"
  ],
  "dienTich": "董仲尋親"
 },
 {
  "so": 58,
  "cap": "Trung bình",
  "tho": [
   "直言說話君須記",
   "莫在他鄉求别藝",
   "切須守己舊生涯",
   "除卻其餘都不利"
  ],
  "dienTich": "文王問卜／張良隱山"
 },
 {
  "so": 59,
  "cap": "Trung bình",
  "tho": [
   "直上重樓去藏身",
   "四圍荊棘繞為林",
   "天高君命長和短",
   "得一番成失二人"
  ],
  "dienTich": "張良隱山／李德裕貶崖州"
 },
 {
  "so": 60,
  "cap": "Hạ",
  "tho": [
   "抱薪救火火增煙",
   "燒卻三千及大千",
   "若問營謀并出入",
   "不如收拾莫憂燃"
  ],
  "dienTich": "赤壁鏖兵"
 },
 {
  "so": 61,
  "cap": "Trung cát",
  "tho": [
   "日裡吟詩月下歌",
   "逢場作戲笑呵呵",
   "相逢會遇難藏避",
   "喝彩齊唱連理羅"
  ],
  "dienTich": "蘇小妹難夫"
 },
 {
  "so": 62,
  "cap": "Trung bình",
  "tho": [
   "晨昏全賴佛扶持",
   "須是逢危卻不危",
   "若得貴人相引處",
   "那時財帛亦相隨"
  ],
  "dienTich": "唐僧得道"
 },
 {
  "so": 63,
  "cap": "Trung bình",
  "tho": [
   "昔日行船失了針",
   "今朝依舊海中尋",
   "若還尋得原針在",
   "也費功夫也費心"
  ],
  "dienTich": "海中尋針"
 },
 {
  "so": 64,
  "cap": "Hạ",
  "tho": [
   "譬若金鱗放碧漪",
   "暗遭羅網四邊圍",
   "思量無計翻身出",
   "命到泉關苦獨悲"
  ],
  "dienTich": "朱買臣馬前覆水"
 },
 {
  "so": 65,
  "cap": "Hạ",
  "tho": [
   "眼前歡喜未為歡",
   "危不危兮安不安",
   "割肉成瘡因甚事",
   "不如守舊待時來"
  ],
  "dienTich": "孫膑困龐涓"
 },
 {
  "so": 66,
  "cap": "Hạ",
  "tho": [
   "路險馬行人去遠",
   "失群羊困虎相當",
   "危灘船過風翻浪",
   "春暮花殘天降霜"
  ],
  "dienTich": "霸王被困"
 },
 {
  "so": 67,
  "cap": "Thượng thượng",
  "tho": [
   "一條金秤等君心",
   "無減無增無重輕",
   "為是平生心性直",
   "文章不識義皆明"
  ],
  "dienTich": "金精試窦兒"
 },
 {
  "so": 68,
  "cap": "Trung bình",
  "tho": [
   "門庭吉慶喜非常",
   "積善之門大吉昌",
   "婚姻田蠶諸事遂",
   "病逢妙藥即安康"
  ],
  "dienTich": "郭汾陽祝壽"
 },
 {
  "so": 69,
  "cap": "Trung bình",
  "tho": [
   "冬來嶺上一枝梅",
   "葉落枝枯終不摧",
   "但得陽春悄急至",
   "依然還我作花魁"
  ],
  "dienTich": "梅開二度"
 },
 {
  "so": 70,
  "cap": "Hạ",
  "tho": [
   "朝朝恰似采花蜂",
   "飛出西南又走東",
   "春盡花殘無覓處",
   "此心不變舊行蹤"
  ],
  "dienTich": "李密反唐"
 },
 {
  "so": 71,
  "cap": "Hạ",
  "tho": [
   "誰知愛寵遇強徒",
   "女子當年嫁二夫",
   "自是一弓施兩箭",
   "騎龍跨馬上安居"
  ],
  "dienTich": "卓文君夜奔司馬相如"
 },
 {
  "so": 72,
  "cap": "Hạ",
  "tho": [
   "弄蜂須要求他蜜",
   "猶恐遭他尾上針",
   "雖是眼前無異路",
   "暗裡深藏荊棘林"
  ],
  "dienTich": "王莽求賢"
 },
 {
  "so": 73,
  "cap": "Thượng thượng",
  "tho": [
   "春雷震起蟄中蟲",
   "脫卻凡塵出舊墉",
   "忽遇風雲交際處",
   "自然變化得成龍"
  ],
  "dienTich": "陳橋兵變"
 },
 {
  "so": 74,
  "cap": "Hạ",
  "tho": [
   "似鹄飛來自入籠",
   "欲得翻身卻不通",
   "南北東西都難出",
   "此卦誠恐恨無窮"
  ],
  "dienTich": "秦敗擒三帥"
 },
 {
  "so": 75,
  "cap": "Trung hạ",
  "tho": [
   "宛如抱虎過山前",
   "戰戰競競膽碎寒",
   "幸得山前逢妙手",
   "方能保得一身安"
  ],
  "dienTich": "伍子胥過昭關"
 },
 {
  "so": 76,
  "cap": "Trung cát",
  "tho": [
   "魚龍混雜意和同",
   "耐守寒潭未濟中",
   "不覺一朝頭角聳",
   "禹門一跳到天宮"
  ],
  "dienTich": "朱元璋洪武看牛／孫叔敖埋蛇"
 },
 {
  "so": 77,
  "cap": "Trung hạ",
  "tho": [
   "夢中說夢獲多財",
   "身外浮名總莫猜",
   "水遠山遙難信定",
   "貴人一指笑顔開"
  ],
  "dienTich": "完璧歸趙／範雎相秦"
 },
 {
  "so": 78,
  "cap": "Thượng cát",
  "tho": [
   "冷水未燒白沸湯",
   "不寒不熱有溫涼",
   "要行天下無難事",
   "唯有身中百藝強"
  ],
  "dienTich": "臨潼救駕／龐洪畏包公"
 },
 {
  "so": 79,
  "cap": "Trung cát",
  "tho": [
   "虛空結願保平安",
   "保得身安願不還",
   "莫忘神聖宜還了",
   "豈知神語莫輕慢"
  ],
  "dienTich": "暗扶倒銅旗"
 },
 {
  "so": 80,
  "cap": "Thượng thượng",
  "tho": [
   "直上高山去學仙",
   "豈知一旦帝王宣",
   "青天白日常明照",
   "志在聲名四海傳"
  ],
  "dienTich": "智遠投軍"
 },
 {
  "so": 81,
  "cap": "Thượng cát",
  "tho": [
   "梧桐葉落秋将暮",
   "行客歸程去似雲",
   "謝得天公高着力",
   "順風船載寶珍歸"
  ],
  "dienTich": "風送滕王閣"
 },
 {
  "so": 82,
  "cap": "Trung bình",
  "tho": [
   "炎炎烈火焰燒天",
   "焰裡還生一朵蓮",
   "到底永成根不壞",
   "依然生葉色新鮮"
  ],
  "dienTich": "火燒葫蘆谷／呂純陽度化柳樹"
 },
 {
  "so": 83,
  "cap": "Trung cát",
  "tho": [
   "譬若初三四五蟾",
   "半無半有未完全",
   "須教十五良宵夜",
   "到處光明到處圓"
  ],
  "dienTich": "李淵登位／李廣灞陵夜獵"
 },
 {
  "so": 84,
  "cap": "Hạ",
  "tho": [
   "因名喪德不和同",
   "切忌忙中變作兇",
   "醉後不知何處去",
   "青松影裡睡朦胧"
  ],
  "dienTich": "莊子試妻"
 },
 {
  "so": 85,
  "cap": "Trung cát",
  "tho": [
   "雲開霧罩山前路",
   "萬物圓中月再圓",
   "若得詩書沉夢醒",
   "貴人指引步天台"
  ],
  "dienTich": "韓文公遇雪"
 },
 {
  "so": 86,
  "cap": "Thượng thượng",
  "tho": [
   "春來花發映陽台",
   "萬裡車來進寶財",
   "若得禹門三級浪",
   "恰如平地一聲雷"
  ],
  "dienTich": "鯉魚躍龍門"
 },
 {
  "so": 87,
  "cap": "Trung bình",
  "tho": [
   "人行半嶺日銜山",
   "峻險崎岩未可攀",
   "仰望上天垂護佑",
   "此身猶在太虛間"
  ],
  "dienTich": "咬金探地穴"
 },
 {
  "so": 88,
  "cap": "Hạ",
  "tho": [
   "木為一虎在當門",
   "須是有威不害人",
   "分明說是無防事",
   "憂惱遲疑恐驚心"
  ],
  "dienTich": "龐洪畏包公"
 },
 {
  "so": 89,
  "cap": "Thượng thượng",
  "tho": [
   "出入營謀大吉昌",
   "無瑕玉在石中藏",
   "如今幸得高人指",
   "獲寶從心喜不常"
  ],
  "dienTich": "石藏珍寶"
 },
 {
  "so": 90,
  "cap": "Thượng thượng",
  "tho": [
   "忽朝一信下天墀",
   "寶貝船裝滿載歸",
   "若問前程成底事",
   "始終應得貴人提"
  ],
  "dienTich": "韋丹救鼋獲報"
 },
 {
  "so": 91,
  "cap": "Thượng thượng",
  "tho": [
   "好把悉眉須展開",
   "大才大用薦将來",
   "一條大路平如掌",
   "凡有施為總稱懷"
  ],
  "dienTich": "三戰呂布／宗愨長風破浪"
 },
 {
  "so": 92,
  "cap": "Thượng thượng",
  "tho": [
   "經商得利稱心懷",
   "福祿榮華倍獲財",
   "若問進身謀望事",
   "秀才一舉狀元回"
  ],
  "dienTich": "蔡卿報恩／李固言柳汁染衣"
 },
 {
  "so": 93,
  "cap": "Trung bình",
  "tho": [
   "鸾鳳翔毛雨淋漓",
   "當時卻被雀兒欺",
   "終教一日雲開達",
   "依舊還君整羽衣"
  ],
  "dienTich": "高君保招親"
 },
 {
  "so": 94,
  "cap": "Trung bình",
  "tho": [
   "小人君子别賢愚",
   "事有差訛合是非",
   "琴遇知音當鼓操",
   "争如定靜得便宜"
  ],
  "dienTich": "琴遇知音"
 },
 {
  "so": 95,
  "cap": "Trung cát",
  "tho": [
   "事業功勤暮與朝",
   "榮華物态不勝饒",
   "報君記取金雞叫",
   "福祿聲名價倍高"
  ],
  "dienTich": "曹丕稱帝／聞雞起舞"
 },
 {
  "so": 96,
  "cap": "Thượng thượng",
  "tho": [
   "巍巍寶塔不尋常",
   "八面玲珑盡放光",
   "勸汝志心勤頂禮",
   "天龍擁護降千祥"
  ],
  "dienTich": "竇燕山積善"
 },
 {
  "so": 97,
  "cap": "Hạ",
  "tho": [
   "園林月色搖疏影",
   "恍若鋪成滿地瓊",
   "幾度童兒來收拾",
   "豈知收拾總成空"
  ],
  "dienTich": "六出祁山"
 },
 {
  "so": 98,
  "cap": "Hạ",
  "tho": [
   "經商出入事遲疑",
   "恐惹閑愁起是非",
   "如鳥飛投羅網陷",
   "相看能有幾人知"
  ],
  "dienTich": "吉平遇難"
 },
 {
  "so": 99,
  "cap": "Trung hạ",
  "tho": [
   "等閑騎馬著鞭來",
   "半有憂危半有財",
   "似火方燒頭上屋",
   "天教一雨蕩殃災"
  ],
  "dienTich": "陶三春掛帥"
 },
 {
  "so": 100,
  "cap": "Hạ",
  "tho": [
   "佛神靈通與君知",
   "癡人說事轉昏迷",
   "老人求得靈籤去",
   "不如守舊待時來"
  ],
  "dienTich": "三教談道"
 }
]